# EditorConfig — universal editor settings
# https://editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

# Markdown: two trailing spaces == hard line break
[*.{md,markdown}]
trim_trailing_whitespace = false

# Config files use 2-space indentation
[*.{yml,yaml,json,toml}]
indent_size = 2

# Web assets
[*.{html,css,js,ts}]
indent_size = 2

# Tabs for Makefiles
[Makefile]
indent_style = tab
