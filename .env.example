# Copy to .env, fill in, and chmod 600 .env on production systems.
# All variables are optional; defaults live in src/cve_monitor/settings.py.

# ── App ──
# CVE_APP_NAME="CVE Monitor"
# CVE_LOG_LEVEL=INFO              # DEBUG / INFO / WARNING / ERROR
# CVE_LOG_FILE=cve-monitor.log
# CVE_LOG_JSON=false              # true => JSON structured logs

# ── Database ──
# Default: sqlite:///./cve_monitor.db
# CVE_DATABASE_URL=sqlite:///./cve_monitor.db
# Postgres example: postgresql+psycopg://user:pass@host:5432/cve

# ── Scheduler ──
# CVE_FETCH_INTERVAL_SECONDS=300
# CVE_SCHEDULER_ENABLED=true

# ── Web ──
# CVE_WEB_HOST=127.0.0.1
# CVE_WEB_PORT=8000
# CVE_WEB_RELOAD=false

# ── Security middleware (opt-in; comma-separated) ──
# TrustedHost: reject any request whose Host header is not in this list.
# Empty (default) disables the check — fine for localhost dev, set for prod.
# CVE_ALLOWED_HOSTS=cve.example.com,localhost
#
# CORS: allow these origins to call the API from a browser.
# API is read-only so only GET is whitelisted regardless.
# CVE_CORS_ORIGINS=https://app.example.com
# CVE_CORS_ALLOW_CREDENTIALS=false

# ── HTTP client ──
# CVE_HTTP_TIMEOUT=30
# CVE_HTTP_USER_AGENT="CVE-Monitor/1.0"
# CVE_HTTP_PROXY=                 # e.g. http://127.0.0.1:7890

# ── Observability (optional; opt-in) ──
# Install the extra:  pip install -e ".[observability]"
# Then set the token from https://logfire.pydantic.dev to enable
# FastAPI / SQLAlchemy / httpx auto-instrumentation.
# LOGFIRE_TOKEN=lf_xxxxxxxxxxxx

# ── Bundled default plugins (all disabled out of the box) ─────────
# Flip the *_ENABLED flag to 1/true/yes to activate. Every collector still
# uses the framework's CollectedItem dedup so re-runs are safe.

# First-hand PoC repos via the nomi-sec PoC-in-GitHub feed (no auth, clean signal)
# CVE_PLUGIN_POC_GITHUB_ENABLED=true
# CVE_PLUGIN_POC_GITHUB_MAX_ITEMS=100

# First-hand PoC repos via live GitHub repository search (catches newest repos)
# CVE_PLUGIN_POC_SEARCH_ENABLED=true
# CVE_PLUGIN_POC_SEARCH_TOKEN=                   # or falls back to GH_TOKEN env (10/min anon, 30/min with PAT)
# CVE_PLUGIN_POC_SEARCH_QUERY="CVE- in:name"     # raw GitHub search qualifier
# CVE_PLUGIN_POC_SEARCH_PER_PAGE=50
# CVE_PLUGIN_POC_SEARCH_REQUIRE_CVE=true         # keep only repos with a concrete CVE-YYYY-NNNN id
                                                 # (drops aggregators / trackers / tooling). false = raw firehose.

# Console notifier — prints every dispatch to structlog. ON by default.
# CVE_PLUGIN_CONSOLE_ENABLED=false               # set to false to silence

# Feishu / Lark group bot — push each new PoC as an interactive card.
# CVE_PLUGIN_FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# CVE_PLUGIN_FEISHU_SECRET=                      # only if the bot has signature verification (签名校验) on
# CVE_PLUGIN_FEISHU_MIN_INTERVAL=0.7             # seconds between sends; throttles under Feishu's 100/min cap. 0 = off

# ── Your own plugin secrets ─────────────────────────────────────
# Naming convention: CVE_PLUGIN_<PLUGIN_NAME>_<KEY>
# Examples:
# CVE_PLUGIN_TELEGRAM_BOT_TOKEN=
# CVE_PLUGIN_TELEGRAM_CHAT_ID=
